{
  "name": "@rs-box/ez-api",
  "version": "1.0.0",
  "description": "API development toolkit powered by TypeSpec",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstanziale/ez-api.git"
  },
  "keywords": [
    "typespec",
    "api",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "husky",
    "format": "biome format --write",
    "format:tsp": "tsp format \"**/*.tsp\"",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest",
    "api:new": "node tools/api-new.ts",
    "api:import": "node tools/api-import.ts",
    "build:all": "node tools/runner.ts -p build:i18n-resources",
    "build:i18n-resources": "node tools/build.ts i18n-resources",
    "watch:i18n-resources": "tsp compile projects/i18n-resources/main.tsp --watch --emit @typespec/openapi3"
  },
  "author": "Roberto B. Stanziale",
  "license": "MIT",
  "dependencies": {
    "@typespec/compiler": "latest",
    "@typespec/http": "latest",
    "@typespec/openapi": "latest",
    "@typespec/openapi3": "latest",
    "@typespec/rest": "latest",
    "@typespec/versioning": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "memfs": "^4.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "private": true
}
